<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GigEVision.Core</RootNamespace>
    <Version>1.0.0</Version>
    <Description>GigE Vision virtual camera core: GVCP/GVSP protocol stack, imaging and push SDK</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- GenICam XML v2 模板（arv-test 对齐版）随程序集分发，GenICamXml 运行时加载 -->
    <EmbeddedResource Include="GenICam\GigEForge.xml" />
  </ItemGroup>
</Project>
